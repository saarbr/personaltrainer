rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing MyWay saves fields on this document, never Jarvis subcollections.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Admin SDK only; owner clients cannot forge memories, approvals or audit.
    match /jarvisUsers/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
